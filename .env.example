# =========================================================================
# PrivacyShield Enterprise SaaS - Environment Configurations Example
# =========================================================================

# 1. API Security & Credentials
SECRET_KEY=your-super-secret-production-key-change-me-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# 2. PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=privacyshield
# For docker orchestration, use the docker host server name:
# POSTGRES_SERVER=db-service

# 3. Redis broker for caching and Celery
REDIS_URL=redis://localhost:6379/0
# For docker orchestration:
# REDIS_URL=redis://redis-service:6379/0

# 4. Local File Storage Mount
UPLOAD_DIR=./backend_storage

# 5. AI Services & Embeddings Configuration
# Provider selection: 'local' (SentenceTransformers via AI service) or 'openai' (API)
EMBEDDING_PROVIDER=local
# Local AI microservice endpoints
AI_SERVICE_URL=http://localhost:8001
# For docker orchestration:
# AI_SERVICE_URL=http://ai-service:8001

# GPU Inference Tuning flags
ENABLE_GPU_INFERENCE=false
LOCAL_MODEL_DEVICE=cpu

# Optional OpenAI Token (required if EMBEDDING_PROVIDER=openai or for advanced RAG)
OPENAI_API_KEY=

# 6. OAuth Integrations (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

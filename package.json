{
  "name": "privacyshield-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/mobile",
    "apps/web",
    "packages/shared",
    "packages/ui"
  ],
  "scripts": {
    "web:dev": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "mobile:start": "npm run start -w apps/mobile",
    "mobile:android": "npm run android -w apps/mobile",
    "mobile:ios": "npm run ios -w apps/mobile",
    "backend:dev": "cd apps/backend && uvicorn app.main:app --reload",
    "ai:dev": "cd ai-services && python main.py",
    "docker:up": "docker-compose up --build",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "react-is": "^19.2.6"
  }
}
